# =============================================================================
#  Maksa API — environment template
# -----------------------------------------------------------------------------
#  Copy to `.env` and place it ABOVE public_html, e.g.:
#     /home/<cpanel_user>/maksa-private/.env       (chmod 600)
#  NEVER commit the real .env. Only this .example file belongs in git.
# =============================================================================

# ---- App ----
APP_NAME="خیرین مکسا"
APP_ENV=production              # production | development
APP_DEBUG=false                 # true only while debugging; leaks error detail
APP_URL=https://erfanteymuri.ir/benefactor-dashboard

# ---- Database (the EXISTING site database) ----
# The panel's tables (panel_users, panel_donations, …) live alongside the site's
# tables in this same database. The panel READS the existing `campaigns` table.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=erfantey_macsacharity
DB_USER=erfantey_fantasticfour
DB_PASS=Diamond19971376@macsa
DB_CHARSET=utf8mb4

# ---- JWT access tokens ----
# Generate a strong 256-bit secret:  php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=5c643acc13407abd726d71074710c76ac48695572d87a4f1307e36cb0aa5d4d7
JWT_ISSUER=erfanteymuri.ir
JWT_ACCESS_TTL=900             # access token lifetime, seconds (15 min)

# ---- Refresh tokens (httpOnly cookie) ----
REFRESH_TTL=2592000            # 30 days, seconds
REFRESH_COOKIE_NAME=maksa_rt
# Cookie path is scoped to the auth endpoints so it's only sent where needed.
REFRESH_COOKIE_PATH=/api/auth
# Leave COOKIE_DOMAIN empty for a host-only cookie (recommended, domain-change-proof).
COOKIE_DOMAIN=

# ---- CORS ----
# Same-origin needs nothing here. For a separate dev origin, list it explicitly
# (comma-separated). Never use "*".
CORS_ALLOWED_ORIGINS=https://erfanteymuri.ir

# ---- Logging ----
LOG_PATH=/home/erfantey/maksa-private/logs/app.log

# ---- Reverse proxy ----
# Set true ONLY if a proxy you control sets X-Forwarded-* headers.
TRUSTED_PROXY=false

# ---- Email (SMTP via cPanel) ----
MAIL_HOST=mail.erfanteymuri.ir
MAIL_PORT=465                  # 465 = implicit TLS (smtps), 587 = STARTTLS
MAIL_ENCRYPTION=tls            # tls | starttls
MAIL_USERNAME=no-reply@erfanteymuri.ir
MAIL_PASSWORD=yXh.hZ5JgSG-vhu
MAIL_FROM_ADDRESS=no-reply@erfanteymuri.ir
MAIL_FROM_NAME="خیرین مکسا"
MAIL_REPLY_TO=info@erfanteymuri.ir

# ---- Payments ----
# stub = no real gateway (records stay 'pending' until you verify in the panel).
# zarinpal = live Zarinpal (fill merchant id; see api/src/Services/Gateway).
PAYMENT_GATEWAY=stub
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# ---- Uploads ----
# Avatar storage dir. Recommended ABOVE web root, served via a guarded endpoint,
# OR a public uploads dir with PHP execution disabled (see README).
UPLOAD_DIR=/home/erfantey/maksa-private/uploads
UPLOAD_MAX_BYTES=2097152       # 2 MB
