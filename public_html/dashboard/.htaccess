RewriteEngine On

# ----------------------------------
# Security
# ----------------------------------
Options -Indexes

# ----------------------------------
# Upload limits (featured/news images)
# ----------------------------------
<IfModule mod_php.c>
    php_value upload_max_filesize 8M
    php_value post_max_size 12M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 8M
    php_value post_max_size 12M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 8M
    php_value post_max_size 12M
</IfModule>

# ---------------------------------------------------------
# Prevent direct access to news-view.php
# (must be accessed only from root URL)
# ---------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/dashboard/news-view\.php [NC]
RewriteRule ^news-view\.php$ / [R=301,L]
# ارجاع آدرس تمیز به فایل PHP
RewriteRule ^personal-resume-detail/(.*)$ personal-resume-detail.php?name=$1 [L,QSA]