RewriteEngine On
RewriteBase /

Options -Indexes

# ----------------------------------
# Custom error pages
# ----------------------------------
ErrorDocument 403 /403.html
ErrorDocument 404 /404.html

# ---- Force HTTPS ----------------------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ---- Redirect root to /home -----------------------------------------------------
RewriteRule ^$ /home [R=301,L]

# ---- Leave the API alone (handled by api/.htaccess) -----------------------------
RewriteRule ^api(/|$) - [L]

# ---- Redirect /benefactor-dashboard  ->  /benefactor-dashboard/ ----------------
RewriteRule ^benefactor-dashboard$ /benefactor-dashboard/ [R=301,L]

# ---- React Router SPA fallback for the dashboard --------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^benefactor-dashboard/(.*)$ /benefactor-dashboard/index.html [L]

# ---------------------------------------------------------
# 0) Maxapedia (مکساپدیا) clean URLs
#    باید پیش از قواعد عمومیِ شعبه/صفحه (3b و 4) بیاید تا
#    /macsapedia/{section} به‌جای page-view.php به صفحه‌ی بخش برود.
#    /macsapedia            -> macsapedia.php (شش کارت)
#    /macsapedia/{section}  -> macsapedia-section.php?section={section}
# ---------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^macsapedia/?$ macsapedia.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^macsapedia/([a-zA-Z0-9_-]+)/?$ macsapedia-section.php?section=$1 [L,QSA]

# ---------------------------------------------------------
# 0.6) دوره‌ها (Courses) clean URLs
#      باید پیش از قواعد عمومیِ شعبه/صفحه (3b و 4) بیاید تا
#      /courses/{...} به‌جای page-view.php به صفحه‌های دوره برود.
#      /courses                 -> dashboard/courses.php (کاتالوگ)
#      /courses/checkout        -> dashboard/course-checkout.php (سبد خرید)
#      /courses/my              -> dashboard/course-my.php (دوره‌های من)
#      /courses/learn/{id}      -> dashboard/course-learn.php?id={id} (پخش‌کننده)
#      /courses/{id}            -> dashboard/course-details.php?id={id} (جزئیات)
# ---------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^courses/?$ dashboard/courses.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^courses/checkout/?$ dashboard/course-checkout.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^courses/my/?$ dashboard/course-my.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^courses/learn/([0-9]+)/?$ dashboard/course-learn.php?id=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^courses/([0-9]+)/?$ dashboard/course-details.php?id=$1 [L,QSA]

# ---------------------------------------------------------
# 1) Redirect old URL
# /dashboard/news-view.php?id=12  ->  /12/
# ---------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/dashboard/news-view\.php\?id=([0-9]+)\s [NC]
RewriteRule ^ /%1/ [R=301,L]

# ---------------------------------------------------------
# 2) News URLs (root domain)
# ---------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([0-9]+)/([^/]+)/?$ dashboard/news-view.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([0-9]+)/?$ dashboard/news-view.php [L,QSA]

# ---------------------------------------------------------
# 3) Page Builder
# ---------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^page/([a-zA-Z0-9-_]+)/?$ dashboard/page-view.php?slug=$1 [L,QSA]

# ---------------------------------------------------------
# 3b) Branch internal routes  /{branch-slug}/{sub-path}
#     مثال: /tabriz-branch/news/12  یا  /tabriz-branch/about
#     page-view.php ابتدا بررسی می‌کند که آیا {slug} یک شعبه است یا نه.
# ---------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9-]+)/(.+?)/?$ dashboard/page-view.php?slug=$1&sub=$2 [L,QSA]

# ---------------------------------------------------------
# 4) Root Pages  /{slug}
#     page-view.php ترتیب resolve را اعمال می‌کند: ابتدا branches.slug سپس صفحه‌ی مرکزی.
# ---------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9-_]+)/?$ dashboard/page-view.php?slug=$1 [L,QSA]

# ---------------------------------------------------------
# 5) Main router (other pages)
# ---------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?route=$1 [L,QSA]

# ---- Security headers (همه صفحات) ----------------------------------------------
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---- CSP فقط برای پنل React (benefactor-dashboard) ----------------------------
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/benefactor-dashboard#">
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://images.unsplash.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    </If>
</IfModule>

# ---- Static asset caching -------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    <FilesMatch "\.(js|css|woff2?|svg|png|jpe?g|webp|gif|ico)$">
        ExpiresDefault "access plus 1 year"
        Header append Cache-Control "public, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        ExpiresDefault "access plus 0 seconds"
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
