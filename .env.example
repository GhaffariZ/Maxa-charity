# Campaign Service (copy these values to the private production .env)
CAMPAIGN_API_BASE_URL=https://campaigns.bonyadala.ir

# One credential set per branch/Center. Branch slug is uppercased and '-' becomes '_'.
CAMPAIGN_CENTER_HQ_CLIENT_ID=replace_on_server
CAMPAIGN_CENTER_HQ_CLIENT_SECRET=replace_on_server
CAMPAIGN_CENTER_HQ_PUBLIC_KEY=replace_on_server

